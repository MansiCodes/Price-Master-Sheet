generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  SUPER_ADMIN
  BUSINESS_HEAD
  PLANT_MANAGER
  ACCOUNTANT
  VIEWER
}

enum PurchaseType {
  CONSUMABLE
  ASSET
  CAPITAL_GOOD
  RAW_MATERIAL
  PACKING
}

enum SaleType {
  FINISHED_GOOD
  OTHERS
}

enum StockCategory {
  RM
  WIP
  FG
}

enum ManpowerShift {
  DAY
  NIGHT
}

enum ManpowerRole {
  MANAGER
  OPERATOR
  HELPER
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String?
  passwordHash       String?
  phone              String?
  globalRole         GlobalRole       @default(ACCOUNTANT)
  canViewPriceSheet  Boolean          @default(false)
  coinsBalance       Int              @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plantRoles         UserPlantRole[]
  purchases          Purchase[]        @relation("PurchaseEnteredBy")
  sales              Sale[]            @relation("SaleEnteredBy")
  stockEntries       StockEntry[]      @relation("StockEnteredBy")
  manpowerEntries    ManpowerEntry[]   @relation("ManpowerEnteredBy")
  productionEntries  ProductionEntry[] @relation("ProductionEnteredBy")
  pettyCashEntries   PettyCashEntry[]  @relation("PettyCashEnteredBy")
  dailyStatuses      DailyEntryStatus[]
  auditLogs          AuditLog[]
  coinsLedger        CoinsLedger[]
  otpChallenges      OtpChallenge[]
}

model Plant {
  id               String                @id @default(cuid())
  name             String                @unique
  code             String                @unique
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  userRoles        UserPlantRole[]
  purchases         Purchase[]
  sales             Sale[]
  stockEntries      StockEntry[]
  manpowerEntries   ManpowerEntry[]
  productionEntries ProductionEntry[]
  pettyCashEntries  PettyCashEntry[]
  electricityRent   ElectricityRent[]
  fixedAssets       FixedAsset[]
  manpowerRates     ManpowerRateSetting[]
  dailyStatuses     DailyEntryStatus[]
}

model UserPlantRole {
  id        String     @id @default(cuid())
  userId    String
  plantId   String
  role      GlobalRole
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant     Plant      @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId])
  @@index([plantId])
}

model Purchase {
  id              String       @id @default(cuid())
  plantId         String
  date            DateTime     @db.Date
  type            PurchaseType
  vendorName      String
  billNumber      String?
  billDate        DateTime?    @db.Date
  itemDescription String
  unit            String
  quantity        Decimal      @db.Decimal(18, 4)
  rate            Decimal      @db.Decimal(18, 4)
  basicValue      Decimal      @db.Decimal(18, 2)
  gstPercent      Decimal      @db.Decimal(5, 2) @default(0)
  gstAmount       Decimal      @db.Decimal(18, 2) @default(0)
  invoiceValue    Decimal      @db.Decimal(18, 2)
  billPhotoUrl    String?
  enteredById     String
  isBackdated     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  plant           Plant        @relation(fields: [plantId], references: [id])
  enteredBy       User         @relation("PurchaseEnteredBy", fields: [enteredById], references: [id])

  @@index([plantId, date])
}

model Sale {
  id              String    @id @default(cuid())
  plantId         String
  date            DateTime  @db.Date
  type            SaleType
  customerName    String
  billNumber      String?
  billDate        DateTime? @db.Date
  itemDescription String
  unit            String
  quantity        Decimal   @db.Decimal(18, 4)
  rate            Decimal   @db.Decimal(18, 4)
  salesValue      Decimal   @db.Decimal(18, 2)
  billPhotoUrl    String?
  enteredById     String
  isBackdated     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  plant           Plant     @relation(fields: [plantId], references: [id])
  enteredBy       User      @relation("SaleEnteredBy", fields: [enteredById], references: [id])

  @@index([plantId, date])
}

model StockEntry {
  id          String        @id @default(cuid())
  plantId     String
  date        DateTime      @db.Date
  itemName    String
  category    StockCategory
  unit        String
  quantity    Decimal       @db.Decimal(18, 4)
  rate        Decimal       @db.Decimal(18, 4)
  closingValue Decimal      @db.Decimal(18, 2)
  enteredById String
  isBackdated Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  plant       Plant         @relation(fields: [plantId], references: [id])
  enteredBy   User          @relation("StockEnteredBy", fields: [enteredById], references: [id])

  @@index([plantId, date])
  @@index([plantId, itemName, date])
}

model ManpowerEntry {
  id          String        @id @default(cuid())
  plantId     String
  date        DateTime      @db.Date
  shift       ManpowerShift
  role        ManpowerRole
  headcount   Int
  ratePerDay  Decimal       @db.Decimal(18, 2)
  totalCost   Decimal       @db.Decimal(18, 2)
  enteredById String
  isBackdated Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  plant       Plant         @relation(fields: [plantId], references: [id])
  enteredBy   User          @relation("ManpowerEnteredBy", fields: [enteredById], references: [id])

  @@index([plantId, date])
}

model ProductionEntry {
  id          String        @id @default(cuid())
  plantId     String
  date        DateTime      @db.Date
  shift       ManpowerShift
  productName String
  quantity    Decimal       @db.Decimal(18, 4)
  unit        String
  notes       String?
  enteredById String
  isBackdated Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  plant       Plant         @relation(fields: [plantId], references: [id])
  enteredBy   User          @relation("ProductionEnteredBy", fields: [enteredById], references: [id])

  @@index([plantId, date])
}

model PettyCashEntry {
  id                String   @id @default(cuid())
  plantId           String
  date              DateTime @db.Date
  payMode           String
  expenseHead       String
  description       String?
  billNumber        String?
  amount            Decimal  @db.Decimal(18, 2) @default(0)
  contractorSalary  Decimal  @db.Decimal(18, 2) @default(0)
  supervisorSalary  Decimal  @db.Decimal(18, 2) @default(0)
  billPhotoUrl      String?
  enteredById       String
  isBackdated       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  plant             Plant    @relation(fields: [plantId], references: [id])
  enteredBy         User     @relation("PettyCashEnteredBy", fields: [enteredById], references: [id])

  @@index([plantId, date])
}

model ElectricityRent {
  id             String   @id @default(cuid())
  plantId        String
  month          DateTime @db.Date
  openingReading Decimal? @db.Decimal(18, 2)
  closingReading Decimal? @db.Decimal(18, 2)
  consumedUnits  Decimal? @db.Decimal(18, 2)
  billAmount     Decimal  @db.Decimal(18, 2) @default(0)
  rentAmount     Decimal  @db.Decimal(18, 2) @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  plant          Plant    @relation(fields: [plantId], references: [id])

  @@unique([plantId, month])
}

model FixedAsset {
  id               String   @id @default(cuid())
  plantId          String
  assetDescription String
  vendor           String?
  billNumber       String?
  billDate         DateTime? @db.Date
  cost             Decimal  @db.Decimal(18, 2)
  gst              Decimal  @db.Decimal(18, 2) @default(0)
  depreciationPercent Decimal @db.Decimal(5, 2) @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  plant            Plant    @relation(fields: [plantId], references: [id])

  @@index([plantId])
}

model ManpowerRateSetting {
  id         String       @id @default(cuid())
  plantId    String
  role       ManpowerRole
  ratePerDay Decimal      @db.Decimal(18, 2)
  effectiveFrom DateTime  @db.Date @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  plant      Plant        @relation(fields: [plantId], references: [id])

  @@unique([plantId, role])
}

model DailyEntryStatus {
  id               String    @id @default(cuid())
  plantId          String
  date             DateTime  @db.Date
  accountantId     String?
  purchaseFilled   Boolean   @default(false)
  saleFilled       Boolean   @default(false)
  stockFilled      Boolean   @default(false)
  manpowerFilled   Boolean   @default(false)
  pettyCashFilled  Boolean   @default(false)
  allComplete      Boolean   @default(false)
  completedAt      DateTime?
  coinsAwarded     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  plant            Plant     @relation(fields: [plantId], references: [id])
  accountant       User?     @relation(fields: [accountantId], references: [id])

  @@unique([plantId, date])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String?
  oldValue   String?
  newValue   String?
  actorId    String
  plantId    String?
  isBackdated Boolean @default(false)
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([plantId, createdAt])
}

model CoinsLedger {
  id        String   @id @default(cuid())
  userId    String
  plantId   String?
  date      DateTime? @db.Date
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ReminderLog {
  id        String   @id @default(cuid())
  plantId   String
  date      DateTime @db.Date
  channel   String
  audience  String
  message   String
  createdAt DateTime @default(now())

  @@index([plantId, date])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone, createdAt])
}
