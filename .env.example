# Copy to .env and fill in values:
#   copy .env.example .env

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Local Docker: postgresql://postgres:postgres@127.0.0.1:5432/plant_pnl
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plant_pnl

SUPER_ADMIN_EMAIL=admin@local.test
SUPER_ADMIN_PASSWORD=
PLANT_MANAGER_EMAIL=manager@cat6.local
PLANT_MANAGER_PASSWORD=
MACHINE_SUPERVISOR_EMAIL=supervisor@machine.local
MACHINE_SUPERVISOR_PASSWORD=

CRON_SECRET=
