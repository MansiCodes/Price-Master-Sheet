# Copy to .env and fill in values:
#   copy .env.example .env

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Local Docker: postgresql://postgres:postgres@127.0.0.1:5432/plant_pnl
# To see the SAME data as AWS Amplify (and write data that appears on AWS):
#   1. Amplify Console → your app → Hosting → Environment variables
#   2. Copy DATABASE_URL exactly into this file (replace the line below)
#   3. Restart: stop npm run dev, then npm run dev again
# WARNING: you will be reading/writing the live production database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plant_pnl

SUPER_ADMIN_EMAIL=admin@local.test
SUPER_ADMIN_PASSWORD=
PLANT_MANAGER_EMAIL=manager@cat6.local
PLANT_MANAGER_PASSWORD=
MACHINE_SUPERVISOR_EMAIL=supervisor@machine.local
MACHINE_SUPERVISOR_PASSWORD=

CRON_SECRET=
# Entries on/after this date require Super Admin approval (YYYY-MM-DD).
# Use a fixed date — defaulting to "today" hid yesterday's pending queue.
SHIFT_APPROVAL_START_DATE=2026-08-01
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_NAME=Master List
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials/service-account.json
